{
  "version": 1,
  "parse": [
    {"name": "empty", "delimiter": ",", "input": "", "bom": false, "raw": [], "terminators": [], "cells": [], "why": "Zero rows; the target for an insert into an empty file."},
    {"name": "only-lf", "delimiter": ",", "input": "\n", "bom": false, "raw": [[""]], "terminators": ["\n"], "cells": [[""]], "why": "A blank line is a row with one zero-width cell."},
    {"name": "only-crlf", "delimiter": ",", "input": "\r\n", "bom": false, "raw": [[""]], "terminators": ["\r\n"], "cells": [[""]], "why": "CRLF is one two-byte terminator."},
    {"name": "only-bom", "delimiter": ",", "input": "\ufeff", "bom": true, "raw": [], "terminators": [], "cells": [], "why": "The BOM is a prefix, not a cell: zero rows."},
    {"name": "bom-data", "delimiter": ",", "input": "\ufeffa,b\n1,2\n", "bom": true, "raw": [["a", "b"], ["1", "2"]], "terminators": ["\n", "\n"], "cells": [["a", "b"], ["1", "2"]], "why": "Cell (0,0) is `a`; the BOM is in no cell."},
    {"name": "bom-quoted-first", "delimiter": ",", "input": "\ufeff\"a,b\",c\n", "bom": true, "raw": [["\"a,b\"", "c"]], "terminators": ["\n"], "cells": [["a,b", "c"]], "why": "A quote right after the BOM still opens a quoted cell."},
    {"name": "bom-not-at-start", "delimiter": ",", "input": "a,\ufeffb\n", "bom": false, "raw": [["a", "\ufeffb"]], "terminators": ["\n"], "cells": [["a", "\ufeffb"]], "why": "U+FEFF anywhere but offset 0 is data."},
    {"name": "bom-twice", "delimiter": ",", "input": "\ufeff\ufeffa\n", "bom": true, "raw": [["\ufeffa"]], "terminators": ["\n"], "cells": [["\ufeffa"]], "why": "Only the first U+FEFF is the BOM; the second is data."},
    {"name": "bom-blank-line", "delimiter": ",", "input": "\ufeff\n", "bom": true, "raw": [[""]], "terminators": ["\n"], "cells": [[""]], "why": "A blank line after the BOM is still a row."},
    {"name": "lf", "delimiter": ",", "input": "a,b\nc,d\n", "bom": false, "raw": [["a", "b"], ["c", "d"]], "terminators": ["\n", "\n"], "cells": [["a", "b"], ["c", "d"]], "why": "Baseline."},
    {"name": "crlf", "delimiter": ",", "input": "a,b\r\nc,d\r\n", "bom": false, "raw": [["a", "b"], ["c", "d"]], "terminators": ["\r\n", "\r\n"], "cells": [["a", "b"], ["c", "d"]], "why": "Each row keeps its terminator as written."},
    {"name": "lone-cr", "delimiter": ",", "input": "a,b\rc,d\r", "bom": false, "raw": [["a", "b"], ["c", "d"]], "terminators": ["\r", "\r"], "cells": [["a", "b"], ["c", "d"]], "why": "A lone CR terminates a row (classic Mac)."},
    {"name": "mixed-terminators", "delimiter": ",", "input": "a\nb\r\nc\rd", "bom": false, "raw": [["a"], ["b"], ["c"], ["d"]], "terminators": ["\n", "\r\n", "\r", ""], "cells": [["a"], ["b"], ["c"], ["d"]], "why": "Terminators are recorded per row; the last row has none."},
    {"name": "lf-then-cr", "delimiter": ",", "input": "a\n\rb", "bom": false, "raw": [["a"], [""], ["b"]], "terminators": ["\n", "\r", ""], "cells": [["a"], [""], ["b"]], "why": "LF then CR is two terminators, not a reversed CRLF."},
    {"name": "cr-cr-lf", "delimiter": ",", "input": "a\r\r\nb", "bom": false, "raw": [["a"], [""], ["b"]], "terminators": ["\r", "\r\n", ""], "cells": [["a"], [""], ["b"]], "why": "A lone CR, then a CRLF."},
    {"name": "no-trailing-newline", "delimiter": ",", "input": "a,b\nc,d", "bom": false, "raw": [["a", "b"], ["c", "d"]], "terminators": ["\n", ""], "cells": [["a", "b"], ["c", "d"]], "why": "The final terminator is empty."},
    {"name": "trailing-blank-lines", "delimiter": ",", "input": "a\n\n\n", "bom": false, "raw": [["a"], [""], [""]], "terminators": ["\n", "\n", "\n"], "cells": [["a"], [""], [""]], "why": "Trailing blank lines are rows; input ending after a terminator adds no further row."},
    {"name": "blank-middle", "delimiter": ",", "input": "a,b\n\nc,d\n", "bom": false, "raw": [["a", "b"], [""], ["c", "d"]], "terminators": ["\n", "\n", "\n"], "cells": [["a", "b"], [""], ["c", "d"]], "why": "Row index equals line number."},
    {"name": "leading-blank", "delimiter": ",", "input": "\n\na,b\n", "bom": false, "raw": [[""], [""], ["a", "b"]], "terminators": ["\n", "\n", "\n"], "cells": [[""], [""], ["a", "b"]], "why": "Leading blank lines are rows."},
    {"name": "whitespace-only-line", "delimiter": ",", "input": "a,b\n  \nc,d\n", "bom": false, "raw": [["a", "b"], ["  "], ["c", "d"]], "terminators": ["\n", "\n", "\n"], "cells": [["a", "b"], ["  "], ["c", "d"]], "why": "Spaces are data, so this line is not blank."},
    {"name": "ragged", "delimiter": ",", "input": "a,b,c\nd\ne,f,g,h\n", "bom": false, "raw": [["a", "b", "c"], ["d"], ["e", "f", "g", "h"]], "terminators": ["\n", "\n", "\n"], "cells": [["a", "b", "c"], ["d"], ["e", "f", "g", "h"]], "why": "Rows keep their own length: no padding, no truncation."},
    {"name": "single-column", "delimiter": ",", "input": "a\nb\nc\n", "bom": false, "raw": [["a"], ["b"], ["c"]], "terminators": ["\n", "\n", "\n"], "cells": [["a"], ["b"], ["c"]], "why": "One cell per row."},
    {"name": "single-cell", "delimiter": ",", "input": "a", "bom": false, "raw": [["a"]], "terminators": [""], "cells": [["a"]], "why": "One cell, no terminator."},
    {"name": "trailing-delimiter", "delimiter": ",", "input": "a,b,\n", "bom": false, "raw": [["a", "b", ""]], "terminators": ["\n"], "cells": [["a", "b", ""]], "why": "The third cell is zero-width."},
    {"name": "only-delimiter", "delimiter": ",", "input": ",", "bom": false, "raw": [["", ""]], "terminators": [""], "cells": [["", ""]], "why": "Two zero-width cells, the second at end of input."},
    {"name": "leading-delimiter", "delimiter": ",", "input": ",a\n", "bom": false, "raw": [["", "a"]], "terminators": ["\n"], "cells": [["", "a"]], "why": "The first cell is zero-width."},
    {"name": "all-empty-cells", "delimiter": ",", "input": "a,,\n,,\n", "bom": false, "raw": [["a", "", ""], ["", "", ""]], "terminators": ["\n", "\n"], "cells": [["a", "", ""], ["", "", ""]], "why": "A row of delimiters is not a blank line."},
    {"name": "quoted-delimiter", "delimiter": ",", "input": "\"a,b\",c\n", "bom": false, "raw": [["\"a,b\"", "c"]], "terminators": ["\n"], "cells": [["a,b", "c"]], "why": "A delimiter inside quotes is data."},
    {"name": "quoted-escaped-quote", "delimiter": ",", "input": "\"a \"\"x\"\" b\",c\n", "bom": false, "raw": [["\"a \"\"x\"\" b\"", "c"]], "terminators": ["\n"], "cells": [["a \"x\" b", "c"]], "why": "A doubled quote inside quotes is one quote."},
    {"name": "quoted-only-quote", "delimiter": ",", "input": "\"\"\"\"\n", "bom": false, "raw": [["\"\"\"\""]], "terminators": ["\n"], "cells": [["\""]], "why": "Four quotes are one quote."},
    {"name": "quoted-trailing-escaped-quote", "delimiter": ",", "input": "\"a\"\"\"\n", "bom": false, "raw": [["\"a\"\"\""]], "terminators": ["\n"], "cells": [["a\""]], "why": "An escaped quote directly before the closing quote."},
    {"name": "quoted-lf", "delimiter": ",", "input": "\"a\nb\",c\n", "bom": false, "raw": [["\"a\nb\"", "c"]], "terminators": ["\n"], "cells": [["a\nb", "c"]], "why": "One row spanning two lines."},
    {"name": "quoted-crlf", "delimiter": ",", "input": "\"a\r\nb\",c\r\n", "bom": false, "raw": [["\"a\r\nb\"", "c"]], "terminators": ["\r\n"], "cells": [["a\r\nb", "c"]], "why": "A CRLF inside quotes is data."},
    {"name": "quoted-lone-cr", "delimiter": ",", "input": "\"a\rb\",c\n", "bom": false, "raw": [["\"a\rb\"", "c"]], "terminators": ["\n"], "cells": [["a\rb", "c"]], "why": "A lone CR inside quotes is data."},
    {"name": "empty-quoted-vs-unquoted", "delimiter": ",", "input": "\"\",\n", "bom": false, "raw": [["\"\"", ""]], "terminators": ["\n"], "cells": [["", ""]], "why": "Same value, different raw text."},
    {"name": "single-empty-quoted", "delimiter": ",", "input": "\"\"\n", "bom": false, "raw": [["\"\""]], "terminators": ["\n"], "cells": [[""]], "why": "Same value as a blank line (only-lf), different raw text."},
    {"name": "stray-quote-unquoted", "delimiter": ",", "input": "a\"b,c\"d\n", "bom": false, "raw": [["a\"b", "c\"d"]], "terminators": ["\n"], "cells": [["a\"b", "c\"d"]], "why": "A quote that is not the cell's first byte is literal."},
    {"name": "text-after-closing-quote", "delimiter": ",", "input": "\"abc\"def,g\n", "bom": false, "raw": [["\"abc\"def", "g"]], "terminators": ["\n"], "cells": [["abcdef", "g"]], "why": "Text after the closing quote is a literal tail of the same cell."},
    {"name": "quote-after-close", "delimiter": ",", "input": "\"a\"b\"c\",d\n", "bom": false, "raw": [["\"a\"b\"c\"", "d"]], "terminators": ["\n"], "cells": [["ab\"c\"", "d"]], "why": "Quotes in the tail are literal."},
    {"name": "tail-keeps-doubled-quotes", "delimiter": ",", "input": "\"a\"b\"\"c,d\n", "bom": false, "raw": [["\"a\"b\"\"c", "d"]], "terminators": ["\n"], "cells": [["ab\"\"c", "d"]], "why": "Doubled quotes in the tail are not unescaped."},
    {"name": "quoted-empty-then-tail", "delimiter": ",", "input": "\"\"x,y\n", "bom": false, "raw": [["\"\"x", "y"]], "terminators": ["\n"], "cells": [["x", "y"]], "why": "An empty quoted part, then a tail."},
    {"name": "unterminated-quote-eof", "delimiter": ",", "input": "a,\"bc\nd,e\n", "bom": false, "raw": [["a", "\"bc\nd,e\n"]], "terminators": [""], "cells": [["a", "bc\nd,e\n"]], "why": "An unclosed quote swallows the rest of the input; the row has no terminator."},
    {"name": "unterminated-quote-only", "delimiter": ",", "input": "\"abc", "bom": false, "raw": [["\"abc"]], "terminators": [""], "cells": [["abc"]], "why": "End of input inside quotes ends the cell."},
    {"name": "lone-quote", "delimiter": ",", "input": "\"", "bom": false, "raw": [["\""]], "terminators": [""], "cells": [[""]], "why": "An opening quote and nothing else."},
    {"name": "escaped-quote-then-eof", "delimiter": ",", "input": "\"a\"\"", "bom": false, "raw": [["\"a\"\""]], "terminators": [""], "cells": [["a\""]], "why": "The final two quotes are an escaped quote, so the cell is unterminated."},
    {"name": "quoted-quote-unterminated", "delimiter": ",", "input": "\"\"\"x", "bom": false, "raw": [["\"\"\"x"]], "terminators": [""], "cells": [["\"x"]], "why": "Opening quote, an escaped quote, then text to end of input."},
    {"name": "quoted-at-eof", "delimiter": ",", "input": "a,\"b\"", "bom": false, "raw": [["a", "\"b\""]], "terminators": [""], "cells": [["a", "b"]], "why": "A closed quoted cell at end of input."},
    {"name": "space-before-quote", "delimiter": ",", "input": " \"a,b\",c\n", "bom": false, "raw": [[" \"a", "b\"", "c"]], "terminators": ["\n"], "cells": [[" \"a", "b\"", "c"]], "why": "The quote is not the cell's first byte, so it does not quote."},
    {"name": "space-after-quote", "delimiter": ",", "input": "\"a\" ,b\n", "bom": false, "raw": [["\"a\" ", "b"]], "terminators": ["\n"], "cells": [["a ", "b"]], "why": "A space after the closing quote is a tail."},
    {"name": "spaces-preserved", "delimiter": ",", "input": " a , b \n", "bom": false, "raw": [[" a ", " b "]], "terminators": ["\n"], "cells": [[" a ", " b "]], "why": "Whitespace is never trimmed."},
    {"name": "unicode-multibyte", "delimiter": ",", "input": "\u00e9,\u00f1\n\u00fc,\u00f8\n", "bom": false, "raw": [["\u00e9", "\u00f1"], ["\u00fc", "\u00f8"]], "terminators": ["\n", "\n"], "cells": [["\u00e9", "\u00f1"], ["\u00fc", "\u00f8"]], "why": "UTF-8 byte offsets differ from UTF-16 offsets."},
    {"name": "unicode-combining", "delimiter": ",", "input": "e\u0301,x\n", "bom": false, "raw": [["e\u0301", "x"]], "terminators": ["\n"], "cells": [["e\u0301", "x"]], "why": "No normalisation: e + U+0301 stays two code points."},
    {"name": "unicode-cjk-wide", "delimiter": ",", "input": "\u540d\u524d,\u5024\n\u6771\u4eac,1\n", "bom": false, "raw": [["\u540d\u524d", "\u5024"], ["\u6771\u4eac", "1"]], "terminators": ["\n", "\n"], "cells": [["\u540d\u524d", "\u5024"], ["\u6771\u4eac", "1"]], "why": "Double-width cells."},
    {"name": "unicode-emoji-zwj", "delimiter": ",", "input": "\ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67,ok\n", "bom": false, "raw": [["\ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67", "ok"]], "terminators": ["\n"], "cells": [["\ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67", "ok"]], "why": "Surrogate pairs joined by U+200D."},
    {"name": "unicode-line-seps-are-data", "delimiter": ",", "input": "a\u2028b,c\u0085d,e\u000bf\fg\n", "bom": false, "raw": [["a\u2028b", "c\u0085d", "e\u000bf\fg"]], "terminators": ["\n"], "cells": [["a\u2028b", "c\u0085d", "e\u000bf\fg"]], "why": "U+2028, U+0085, VT and FF are data; only CR and LF end a row."},
    {"name": "nul", "delimiter": ",", "input": "a\u0000b,c\n", "bom": false, "raw": [["a\u0000b", "c"]], "terminators": ["\n"], "cells": [["a\u0000b", "c"]], "why": "NUL is an ordinary character."},
    {"name": "csv-with-tabs", "delimiter": ",", "input": "a\tb,c\n", "bom": false, "raw": [["a\tb", "c"]], "terminators": ["\n"], "cells": [["a\tb", "c"]], "why": "A tab is data in CSV."},
    {"name": "comment-like", "delimiter": ",", "input": "#c,d\n", "bom": false, "raw": [["#c", "d"]], "terminators": ["\n"], "cells": [["#c", "d"]], "why": "There is no comment syntax."},
    {"name": "sep-line", "delimiter": ",", "input": "sep=;\na;b\n", "bom": false, "raw": [["sep=;"], ["a;b"]], "terminators": ["\n", "\n"], "cells": [["sep=;"], ["a;b"]], "why": "The Excel `sep=` hint is not interpreted."},
    {"name": "tsv-basic", "delimiter": "\t", "input": "a\tb\n1\t2\n", "bom": false, "raw": [["a", "b"], ["1", "2"]], "terminators": ["\n", "\n"], "cells": [["a", "b"], ["1", "2"]], "why": "Baseline TSV."},
    {"name": "tsv-quoted", "delimiter": "\t", "input": "\"a\tb\"\tc\n", "bom": false, "raw": [["\"a\tb\"", "c"]], "terminators": ["\n"], "cells": [["a\tb", "c"]], "why": "Quotes are honoured in TSV."},
    {"name": "tsv-with-commas", "delimiter": "\t", "input": "a,b\tc\n", "bom": false, "raw": [["a,b", "c"]], "terminators": ["\n"], "cells": [["a,b", "c"]], "why": "A comma is data in TSV."},
    {"name": "tsv-mid-quote", "delimiter": "\t", "input": "5\" disk\tx\n", "bom": false, "raw": [["5\" disk", "x"]], "terminators": ["\n"], "cells": [["5\" disk", "x"]], "why": "A quote that is not the cell's first byte is literal."},
    {"name": "tsv-unbalanced-leading-quote", "delimiter": "\t", "input": "\"hello\tx\ny\tz\n", "bom": false, "raw": [["\"hello\tx\ny\tz\n"]], "terminators": [""], "cells": [["hello\tx\ny\tz\n"]], "why": "The cost of honouring quotes in TSV: one leading quote swallows the rest."},
    {"name": "trailing-delim-crlf", "delimiter": ",", "input": "a,\r\nb", "bom": false, "raw": [["a", ""], ["b"]], "terminators": ["\r\n", ""], "cells": [["a", ""], ["b"]], "why": "A trailing delimiter, then a CRLF: the empty last cell ends before the terminator."},
    {"name": "cr-after-cell-before-delimiter", "delimiter": ",", "input": "a\r,b", "bom": false, "raw": [["a"], ["", "b"]], "terminators": ["\r", ""], "cells": [["a"], ["", "b"]], "why": "A lone CR ends the row even when a delimiter follows; the next row starts with an empty cell."}
  ],
  "edits": [
    {"name": "set-plain", "delimiter": ",", "input": "a,b\nc,d\n", "op": "set_cell", "args": {"row": 1, "col": 0, "value": "X"}, "output": "a,b\nX,d\n"},
    {"name": "set-needs-quote-delim", "delimiter": ",", "input": "a,b\n", "op": "set_cell", "args": {"row": 0, "col": 1, "value": "x,y"}, "output": "a,\"x,y\"\n"},
    {"name": "set-needs-quote-quote", "delimiter": ",", "input": "a,b\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "say \"hi\""}, "output": "\"say \"\"hi\"\"\",b\n"},
    {"name": "set-newline", "delimiter": ",", "input": "a,b\r\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "l1\nl2"}, "output": "\"l1\nl2\",b\r\n", "why": "A newline in a value is written verbatim inside quotes, not as the file's terminator."},
    {"name": "set-value-with-cr", "delimiter": ",", "input": "a,b\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "x\ry"}, "output": "\"x\ry\",b\n"},
    {"name": "set-keeps-quoted-style", "delimiter": ",", "input": "\"a\",b\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "z"}, "output": "\"z\",b\n", "why": "A well-formed quoted cell stays quoted even when the new value needs no quotes."},
    {"name": "set-crlf-untouched", "delimiter": ",", "input": "\"a\",\"b\"\r\n\"c\",\"d\"\r\n", "op": "set_cell", "args": {"row": 1, "col": 1, "value": "D"}, "output": "\"a\",\"b\"\r\n\"c\",\"D\"\r\n"},
    {"name": "set-no-trailing-newline", "delimiter": ",", "input": "a,b\nc,d", "op": "set_cell", "args": {"row": 1, "col": 1, "value": "D"}, "output": "a,b\nc,D"},
    {"name": "set-quoted-to-empty", "delimiter": ",", "input": "\"a\",b\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": ""}, "output": "\"\",b\n"},
    {"name": "set-unquoted-to-empty", "delimiter": ",", "input": "a,b\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": ""}, "output": ",b\n"},
    {"name": "set-last-cell-to-empty", "delimiter": ",", "input": "a,b\n", "op": "set_cell", "args": {"row": 0, "col": 1, "value": ""}, "output": "a,\n"},
    {"name": "set-sole-cell-empty", "delimiter": ",", "input": "a\nb\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": ""}, "output": "\"\"\nb\n", "why": "A row's only cell is never written as a bare blank line."},
    {"name": "set-sole-cell-empty-at-eof", "delimiter": ",", "input": "a\nb", "op": "set_cell", "args": {"row": 1, "col": 0, "value": ""}, "output": "a\n\"\""},
    {"name": "set-quoted-sole-cell-empty", "delimiter": ",", "input": "\"a\"\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": ""}, "output": "\"\"\n"},
    {"name": "set-same-value-noop", "delimiter": ",", "input": "a\"b,c\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "a\"b"}, "noop": true, "output": "a\"b,c\n", "why": "A cell is never rewritten to its own value, so a malformed cell is not normalised."},
    {"name": "set-quoted-same-value-noop", "delimiter": ",", "input": "\"a\",b\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "a"}, "noop": true, "output": "\"a\",b\n"},
    {"name": "set-malformed-same-value-noop", "delimiter": ",", "input": "\"abc\"def,g\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "abcdef"}, "noop": true, "output": "\"abc\"def,g\n", "why": "The value of a cell with a tail is its unescaped quoted part plus the tail."},
    {"name": "set-unterminated-same-value-noop", "delimiter": ",", "input": "a,\"bc", "op": "set_cell", "args": {"row": 0, "col": 1, "value": "bc"}, "noop": true, "output": "a,\"bc"},
    {"name": "set-blank-line-empty-noop", "delimiter": ",", "input": "a\n\nb\n", "op": "set_cell", "args": {"row": 1, "col": 0, "value": ""}, "noop": true, "output": "a\n\nb\n", "why": "The no-change rule comes first: a bare blank line is not rewritten to a quoted empty cell."},
    {"name": "set-malformed-cell", "delimiter": ",", "input": "\"abc\"def,g\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "x"}, "output": "x,g\n", "why": "Text after the closing quote makes the old cell malformed, which counts as unquoted style."},
    {"name": "set-unterminated-cell", "delimiter": ",", "input": "a,\"bc", "op": "set_cell", "args": {"row": 0, "col": 1, "value": "z"}, "output": "a,z", "why": "An unterminated quote is malformed, which counts as unquoted style."},
    {"name": "set-unterminated-swallowed-rest", "delimiter": ",", "input": "a,\"bc\nd,e\n", "op": "set_cell", "args": {"row": 0, "col": 1, "value": "z"}, "output": "a,z", "why": "The cell runs to end of input, so all of it is replaced."},
    {"name": "set-multiline-cell", "delimiter": ",", "input": "\"l1\nl2\",x\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "y"}, "output": "\"y\",x\n"},
    {"name": "set-escaped-cell", "delimiter": ",", "input": "\"a \"\"x\"\" b\",c\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "q\""}, "output": "\"q\"\"\",c\n"},
    {"name": "set-trailing-empty-cell", "delimiter": ",", "input": "a,b,\n", "op": "set_cell", "args": {"row": 0, "col": 2, "value": "z"}, "output": "a,b,z\n"},
    {"name": "set-ragged-pad", "delimiter": ",", "input": "a,b,c\nd\n", "op": "set_cell", "args": {"row": 1, "col": 2, "value": "z"}, "output": "a,b,c\nd,,z\n", "why": "A missing cell is created by padding only that row with delimiters."},
    {"name": "set-pad-quoted-value", "delimiter": ",", "input": "a,b\nc\n", "op": "set_cell", "args": {"row": 1, "col": 1, "value": "x,y"}, "output": "a,b\nc,\"x,y\"\n"},
    {"name": "set-pad-blank-line", "delimiter": ",", "input": "a,b\n\n", "op": "set_cell", "args": {"row": 1, "col": 1, "value": "z"}, "output": "a,b\n,z\n"},
    {"name": "set-pad-no-trailing-newline", "delimiter": ",", "input": "a,b\nc", "op": "set_cell", "args": {"row": 1, "col": 1, "value": "z"}, "output": "a,b\nc,z"},
    {"name": "set-pad-closes-open-quote", "delimiter": ",", "input": "a,b\n\"c", "op": "set_cell", "args": {"row": 1, "col": 1, "value": "z"}, "output": "a,b\n\"c\",z", "why": "Text added after an unterminated quoted cell first closes its quote, or the cell would swallow it."},
    {"name": "set-missing-empty-noop", "delimiter": ",", "input": "a,b\nc\n", "op": "set_cell", "args": {"row": 1, "col": 1, "value": ""}, "noop": true, "output": "a,b\nc\n", "why": "Setting a missing cell to empty changes nothing."},
    {"name": "set-blank-line", "delimiter": ",", "input": "a\n\nb\n", "op": "set_cell", "args": {"row": 1, "col": 0, "value": "x"}, "output": "a\nx\nb\n"},
    {"name": "set-bom-preserved", "delimiter": ",", "input": "\ufeffa,b\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "A"}, "output": "\ufeffA,b\n"},
    {"name": "set-mixed-terms", "delimiter": ",", "input": "a\nb\r\nc\rd", "op": "set_cell", "args": {"row": 2, "col": 0, "value": "C"}, "output": "a\nb\r\nC\rd"},
    {"name": "set-space-not-quoted", "delimiter": ",", "input": "a,b\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": " x "}, "output": " x ,b\n", "why": "Leading and trailing spaces do not force quotes."},
    {"name": "set-leading-feff-quoted", "delimiter": ",", "input": "a,b\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "\ufeffx"}, "output": "\"\ufeffx\",b\n", "why": "Unquoted at offset 0, the value's U+FEFF would be read back as a BOM."},
    {"name": "set-leading-feff-quoted-anywhere", "delimiter": ",", "input": "a,b\n", "op": "set_cell", "args": {"row": 0, "col": 1, "value": "\ufeffx"}, "output": "a,\"\ufeffx\"\n", "why": "A value starting with U+FEFF is quoted wherever it is written."},
    {"name": "set-leading-feff-after-bom", "delimiter": ",", "input": "\ufeffa\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "\ufeffb"}, "output": "\ufeff\"\ufeffb\"\n"},
    {"name": "set-tsv-tab", "delimiter": "\t", "input": "a\tb\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "x\ty"}, "output": "\"x\ty\"\tb\n"},
    {"name": "set-tsv-comma-bare", "delimiter": "\t", "input": "a\tb\n", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "x,y"}, "output": "x,y\tb\n"},
    {"name": "set-tsv-quote", "delimiter": "\t", "input": "a\tb\n", "op": "set_cell", "args": {"row": 0, "col": 1, "value": "5\" disk"}, "output": "a\t\"5\"\" disk\"\n"},
    {"name": "set-tsv-pad", "delimiter": "\t", "input": "a\tb\nc\n", "op": "set_cell", "args": {"row": 1, "col": 1, "value": "z"}, "output": "a\tb\nc\tz\n"},
    {"name": "set-row-out-of-range", "delimiter": ",", "input": "a\n", "op": "set_cell", "args": {"row": 5, "col": 0, "value": "x"}, "error": "row_out_of_bounds"},
    {"name": "set-col-out-of-range", "delimiter": ",", "input": "a\n", "op": "set_cell", "args": {"row": 0, "col": 1, "value": "x"}, "error": "col_out_of_bounds", "why": "A column at or past the table's width is an error; only narrower rows are padded."},
    {"name": "set-col-out-of-range-empty-value", "delimiter": ",", "input": "a\n", "op": "set_cell", "args": {"row": 0, "col": 1, "value": ""}, "error": "col_out_of_bounds", "why": "Bounds are checked before the no-change rules."},
    {"name": "set-empty-table", "delimiter": ",", "input": "", "op": "set_cell", "args": {"row": 0, "col": 0, "value": "x"}, "error": "row_out_of_bounds"},
    {"name": "ins-middle", "delimiter": ",", "input": "a,b\nc,d\n", "op": "insert_row", "args": {"at": 1, "cells": ["x", "y"]}, "output": "a,b\nx,y\nc,d\n"},
    {"name": "ins-crlf", "delimiter": ",", "input": "a,b\r\n", "op": "insert_row", "args": {"at": 1, "cells": ["x", "y"]}, "output": "a,b\r\nx,y\r\n"},
    {"name": "ins-append-no-trailing-newline", "delimiter": ",", "input": "a,b\nc,d", "op": "insert_row", "args": {"at": 2, "cells": ["x", "y"]}, "output": "a,b\nc,d\nx,y", "why": "The file still ends without a newline."},
    {"name": "ins-append-crlf-no-trailing-newline", "delimiter": ",", "input": "a\r\nb", "op": "insert_row", "args": {"at": 2, "cells": ["c"]}, "output": "a\r\nb\r\nc"},
    {"name": "ins-append-lone-cr-no-trailing-newline", "delimiter": ",", "input": "a\rb", "op": "insert_row", "args": {"at": 2, "cells": ["c"]}, "output": "a\rb\rc"},
    {"name": "ins-at-0-bom", "delimiter": ",", "input": "\ufeffa\n", "op": "insert_row", "args": {"at": 0, "cells": ["h"]}, "output": "\ufeffh\na\n", "why": "Row 0 starts just after the BOM."},
    {"name": "ins-at-0-no-terminator", "delimiter": ",", "input": "a", "op": "insert_row", "args": {"at": 0, "cells": ["x"]}, "output": "x\na", "why": "No terminator to copy, so LF."},
    {"name": "ins-empty-file", "delimiter": ",", "input": "", "op": "insert_row", "args": {"at": 0, "cells": ["x", "y"]}, "output": "x,y\n"},
    {"name": "ins-bom-only", "delimiter": ",", "input": "\ufeff", "op": "insert_row", "args": {"at": 0, "cells": ["x"]}, "output": "\ufeffx\n"},
    {"name": "ins-no-cells-empty-file", "delimiter": ",", "input": "", "op": "insert_row", "args": {"at": 0, "cells": []}, "output": "\"\"\n", "why": "Width is at least 1, and a one-cell empty row is written as a quoted empty cell."},
    {"name": "ins-empty-row", "delimiter": ",", "input": "a,b,c\n", "op": "insert_row", "args": {"at": 1, "cells": ["", "", ""]}, "output": "a,b,c\n,,\n"},
    {"name": "ins-pads-to-width", "delimiter": ",", "input": "a,b,c\n", "op": "insert_row", "args": {"at": 1, "cells": []}, "output": "a,b,c\n,,\n", "why": "Missing cells are empty, up to the table's width."},
    {"name": "ins-short-row-padded", "delimiter": ",", "input": "a,b\n", "op": "insert_row", "args": {"at": 0, "cells": ["x"]}, "output": "x,\na,b\n"},
    {"name": "ins-wider-than-table", "delimiter": ",", "input": "a\n", "op": "insert_row", "args": {"at": 0, "cells": ["x", "y"]}, "output": "x,y\na\n", "why": "Other rows are not padded."},
    {"name": "ins-single-col-empty", "delimiter": ",", "input": "a\n", "op": "insert_row", "args": {"at": 1, "cells": [""]}, "output": "a\n\"\"\n"},
    {"name": "ins-quoting", "delimiter": ",", "input": "a,b\n", "op": "insert_row", "args": {"at": 1, "cells": ["x,y", "q\""]}, "output": "a,b\n\"x,y\",\"q\"\"\"\n"},
    {"name": "ins-multiline-value", "delimiter": ",", "input": "a\n", "op": "insert_row", "args": {"at": 1, "cells": ["l1\nl2"]}, "output": "a\n\"l1\nl2\"\n"},
    {"name": "ins-leading-feff-quoted", "delimiter": ",", "input": "", "op": "insert_row", "args": {"at": 0, "cells": ["\ufeffx"]}, "output": "\"\ufeffx\"\n"},
    {"name": "ins-lone-cr", "delimiter": ",", "input": "a\rb\r", "op": "insert_row", "args": {"at": 1, "cells": ["x"]}, "output": "a\rx\rb\r"},
    {"name": "ins-first-terminator-wins", "delimiter": ",", "input": "a\r\nb\nc\n", "op": "insert_row", "args": {"at": 3, "cells": ["x"]}, "output": "a\r\nb\nc\nx\r\n", "why": "The new row uses the first non-empty row terminator in the table."},
    {"name": "ins-terminator-ignores-cell-newlines", "delimiter": ",", "input": "\"a\r\nb\"\nc\n", "op": "insert_row", "args": {"at": 2, "cells": ["x"]}, "output": "\"a\r\nb\"\nc\nx\n", "why": "A newline inside a quoted cell is not a row terminator."},
    {"name": "ins-before-blank-line", "delimiter": ",", "input": "a\n\nb\n", "op": "insert_row", "args": {"at": 1, "cells": ["x"]}, "output": "a\nx\n\nb\n"},
    {"name": "ins-append-after-blank-line", "delimiter": ",", "input": "a\n\n", "op": "insert_row", "args": {"at": 2, "cells": ["x"]}, "output": "a\n\nx\n"},
    {"name": "ins-append-closes-open-quote", "delimiter": ",", "input": "\"a", "op": "insert_row", "args": {"at": 1, "cells": ["x"]}, "output": "\"a\"\nx", "why": "Text added after an unterminated quoted cell first closes its quote, or the cell would swallow it."},
    {"name": "ins-lone-cr-before-blank-lf", "delimiter": ",", "input": "a\rb\n\n", "op": "insert_row", "args": {"at": 2, "cells": ["x"]}, "output": "a\rb\nx\r\n\n", "why": "A CR terminator written right before an LF would fuse into one CRLF and drop the blank row, so CRLF is written."},
    {"name": "ins-tsv", "delimiter": "\t", "input": "a\tb\n", "op": "insert_row", "args": {"at": 1, "cells": ["x\ty", "z"]}, "output": "a\tb\n\"x\ty\"\tz\n"},
    {"name": "ins-out-of-range", "delimiter": ",", "input": "a\n", "op": "insert_row", "args": {"at": 2, "cells": ["x"]}, "error": "row_out_of_bounds"},
    {"name": "del-middle", "delimiter": ",", "input": "a\nb\nc\n", "op": "delete_row", "args": {"row": 1}, "output": "a\nc\n"},
    {"name": "del-first", "delimiter": ",", "input": "a\nb\n", "op": "delete_row", "args": {"row": 0}, "output": "b\n"},
    {"name": "del-first-no-trailing-newline", "delimiter": ",", "input": "a\nb", "op": "delete_row", "args": {"row": 0}, "output": "b"},
    {"name": "del-last-trailing-newline", "delimiter": ",", "input": "a\nb\n", "op": "delete_row", "args": {"row": 1}, "output": "a\n"},
    {"name": "del-last-no-trailing-newline", "delimiter": ",", "input": "a\nb", "op": "delete_row", "args": {"row": 1}, "output": "a", "why": "The previous row's terminator goes too, so the file still ends without a newline."},
    {"name": "del-last-crlf-no-trailing-newline", "delimiter": ",", "input": "a\r\nb", "op": "delete_row", "args": {"row": 1}, "output": "a"},
    {"name": "del-last-keeps-blank-previous", "delimiter": ",", "input": "a\n\nb", "op": "delete_row", "args": {"row": 2}, "output": "a\n\n", "why": "A bare blank line keeps its terminator: without it the row would cease to exist."},
    {"name": "del-last-after-blank-first-row", "delimiter": ",", "input": "\nb", "op": "delete_row", "args": {"row": 1}, "output": "\n"},
    {"name": "del-last-after-quoted-empty", "delimiter": ",", "input": "\"\"\nb", "op": "delete_row", "args": {"row": 1}, "output": "\"\"", "why": "The previous row's raw text is two bytes, not zero, so its terminator is removed."},
    {"name": "del-last-unterminated-quote", "delimiter": ",", "input": "a\n\"b", "op": "delete_row", "args": {"row": 1}, "output": "a"},
    {"name": "del-only", "delimiter": ",", "input": "a\n", "op": "delete_row", "args": {"row": 0}, "output": ""},
    {"name": "del-only-no-newline", "delimiter": ",", "input": "a", "op": "delete_row", "args": {"row": 0}, "output": ""},
    {"name": "del-only-bom", "delimiter": ",", "input": "\ufeffa\n", "op": "delete_row", "args": {"row": 0}, "output": "\ufeff", "why": "The BOM is never removed."},
    {"name": "del-only-swallowing-row", "delimiter": ",", "input": "a,\"bc\nd,e\n", "op": "delete_row", "args": {"row": 0}, "output": ""},
    {"name": "del-blank-line", "delimiter": ",", "input": "a\n\nb\n", "op": "delete_row", "args": {"row": 1}, "output": "a\nb\n"},
    {"name": "del-multiline-row", "delimiter": ",", "input": "h\n\"l1\nl2\",x\nz\n", "op": "delete_row", "args": {"row": 1}, "output": "h\nz\n"},
    {"name": "del-multiline-row-crlf", "delimiter": ",", "input": "\"a\r\nb\",c\r\nd,e\r\n", "op": "delete_row", "args": {"row": 0}, "output": "d,e\r\n"},
    {"name": "del-mixed-terminators", "delimiter": ",", "input": "a\nb\r\nc\rd", "op": "delete_row", "args": {"row": 1}, "output": "a\nc\rd"},
    {"name": "del-lone-cr", "delimiter": ",", "input": "a\rb\rc\r", "op": "delete_row", "args": {"row": 1}, "output": "a\rc\r"},
    {"name": "del-first-bom", "delimiter": ",", "input": "\ufeffa\nb\n", "op": "delete_row", "args": {"row": 0}, "output": "\ufeffb\n"},
    {"name": "del-keeps-lf-after-lone-cr", "delimiter": ",", "input": "a\rb\n\n", "op": "delete_row", "args": {"row": 1}, "output": "a\r\n\n", "why": "Removing all of row 1 would fuse row 0's CR with the blank row's LF into one CRLF and drop the blank row, so row 1's final LF is kept."},
    {"name": "del-keeps-lf-after-lone-cr-crlf", "delimiter": ",", "input": "a\rb\r\n\n", "op": "delete_row", "args": {"row": 1}, "output": "a\r\n\n"},
    {"name": "del-first-quotes-exposed-feff", "delimiter": ",", "input": "a\n\ufeffb\n", "op": "delete_row", "args": {"row": 0}, "output": "\"\ufeffb\"\n", "why": "Left unquoted at offset 0, the next row's U+FEFF would be read back as a BOM, so that cell is rewritten quoted."},
    {"name": "del-first-quotes-exposed-feff-escapes", "delimiter": ",", "input": "a\n\ufeff\"b\n", "op": "delete_row", "args": {"row": 0}, "output": "\"\ufeff\"\"b\"\n"},
    {"name": "del-first-feff-after-bom", "delimiter": ",", "input": "\ufeffa\n\ufeffb\n", "op": "delete_row", "args": {"row": 0}, "output": "\ufeff\ufeffb\n", "why": "The file's BOM stays at offset 0, so the next row's U+FEFF is still data."},
    {"name": "del-out-of-range", "delimiter": ",", "input": "a\n", "op": "delete_row", "args": {"row": 1}, "error": "row_out_of_bounds"},
    {"name": "del-empty-table", "delimiter": ",", "input": "", "op": "delete_row", "args": {"row": 0}, "error": "row_out_of_bounds"},
    {"name": "ins-append-single-unterminated-default-lf", "delimiter": ",", "input": "\"a\"", "op": "insert_row", "args": {"at": 1, "cells": ["x"]}, "output": "\"a\"\nx", "why": "No row has a terminator, so the new one falls back to LF."},
    {"name": "ins-append-tsv-open-quote", "delimiter": "\t", "input": "\"a\tb", "op": "insert_row", "args": {"at": 1, "cells": ["x"]}, "output": "\"a\tb\"\nx", "why": "The closing-quote seam applies to TSV too."},
    {"name": "del-last-lone-cr-no-trailing", "delimiter": ",", "input": "a\rb", "op": "delete_row", "args": {"row": 1}, "output": "a", "why": "The previous row's lone CR goes with the unterminated last row."},
    {"name": "del-seam-blank-crlf-row", "delimiter": ",", "input": "a\r\r\n\nb", "op": "delete_row", "args": {"row": 1}, "output": "a\r\n\nb", "why": "Deleting a blank CRLF row after a lone-CR row keeps the final LF so the next blank row survives."},
    {"name": "set-pad-leading-feff", "delimiter": ",", "input": "a,b\nc\n", "op": "set_cell", "args": {"row": 1, "col": 1, "value": "\ufeffx"}, "output": "a,b\nc,\"\ufeffx\"\n", "why": "A value starting with U+FEFF is quoted when it pads a short row."},
    {"name": "ins-leading-feff-mid", "delimiter": ",", "input": "a\n", "op": "insert_row", "args": {"at": 1, "cells": ["\ufeffx"]}, "output": "a\n\"\ufeffx\"\n", "why": "A value starting with U+FEFF is quoted in an inserted row, not only at row 0."},
    {"name": "set-pad-open-quote-tsv", "delimiter": "\t", "input": "a\tb\n\"c", "op": "set_cell", "args": {"row": 1, "col": 1, "value": "z"}, "output": "a\tb\n\"c\"\tz", "why": "Padding a short row that ends in an unclosed quote closes it first, in TSV as in CSV."}
  ]
}
